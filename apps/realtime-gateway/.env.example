APP_ENV=development
REALTIME_LISTEN_ADDR=:8081
REALTIME_AUTH_VERIFY_URL=http://127.0.0.1:8000/api/v1/realtime/verify
REALTIME_REDIS_URL=redis://127.0.0.1:6380/0
REALTIME_REDIS_POOL_SIZE=100
REALTIME_REDIS_POOL_TIMEOUT=2s
REALTIME_REDIS_READ_TIMEOUT=2s
REALTIME_REDIS_WRITE_TIMEOUT=2s
REALTIME_REDIS_LEASE_TTL=60s
REALTIME_NODE_ID=gateway-local
REALTIME_ORIGINS=http://localhost:3000,http://localhost:8080
REALTIME_DRAIN_TIMEOUT=45s
REALTIME_MAX_CONNECTIONS=10000
REALTIME_MAX_CONNECTIONS_PER_USER=4
