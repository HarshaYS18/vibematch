class HomePage extends StatefulWidget {
  const HomePage({
    super.key,
    required this.user,
  });

  final CurrentUser user;

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  late final PageController _bannerController;
  late final ScrollController _scrollController;

  int _currentBannerIndex = 0;
  int _visibleRoomCount = 8;
  bool _isLoadingMore = false;

  String _selectedCategory = 'Trending';
  String _selectedLanguage = 'All';

  @override
  void initState() {
    super.initState();
    _bannerController = PageController(viewportFraction: 0.90);
    _scrollController = ScrollController();
    _scrollController.addListener(_handleInfiniteScroll);
  }

  @override
  void dispose() {
    _bannerController.dispose();
    _scrollController.dispose();
    super.dispose();
  }

  bool get _canManageBanners {
    return widget.user.primaryRole == 'founder_owner' ||
        widget.user.primaryRole == 'owner';
  }

  List<_RoomItem> get _filteredRooms {
    Iterable<_RoomItem> rooms = _roomItems;

    if (_selectedCategory == 'Following') {
      rooms = rooms.where((room) => room.followedFriendsInside.isNotEmpty);
    } else if (_selectedCategory != 'Trending') {
      rooms = rooms.where((room) => room.type == _selectedCategory);
    }

    if (_selectedLanguage != 'All') {
      rooms = rooms.where((room) => room.language == _selectedLanguage);
    }

    final list = rooms.toList()
      ..sort((a, b) => b.trendingScore.compareTo(a.trendingScore));

    return list;
  }

  List<_RoomItem> get _visibleRooms {
    final rooms = _filteredRooms;
    final end = _visibleRoomCount > rooms.length ? rooms.length : _visibleRoomCount;
    return rooms.take(end).toList();
  }

  void _handleInfiniteScroll() {
    if (!_scrollController.hasClients) return;
    if (_isLoadingMore) return;

    final position = _scrollController.position;
    final nearBottom = position.pixels >= position.maxScrollExtent - 280;

    if (!nearBottom) return;
    if (_visibleRoomCount >= _filteredRooms.length) return;

    setState(() {
      _isLoadingMore = true;
    });

    Future.delayed(const Duration(milliseconds: 450), () {
      if (!mounted) return;

      setState(() {
        _visibleRoomCount += 6;
        _isLoadingMore = false;
      });
    });
  }

  void _selectCategory(String category) {
    setState(() {
      _selectedCategory = category;
      _visibleRoomCount = 8;
    });
  }

  void _selectLanguage(String language) {
    setState(() {
      _selectedLanguage = language;
      _visibleRoomCount = 8;
    });
  }

  void _showToast(String message) {
    ScaffoldMessenger.of(context)
      ..clearSnackBars()
      ..showSnackBar(
        SnackBar(
          behavior: SnackBarBehavior.floating,
          backgroundColor: const Color(0xFF251538),
          content: Text(
            message,
            style: const TextStyle(fontWeight: FontWeight.w800),
          ),
        ),
      );
  }

  void _openLanguageSheet() {
    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (context) {
        return DraggableScrollableSheet(
          initialChildSize: 0.72,
          minChildSize: 0.42,
          maxChildSize: 0.92,
          expand: false,
          builder: (context, scrollController) {
            return _LanguageSheet(
              scrollController: scrollController,
              selectedLanguage: _selectedLanguage,
              onSelected: (language) {
                Navigator.pop(context);
                _selectLanguage(language);
              },
            );
          },
        );
      },
    );
  }

  void _openFollowingRooms() {
    _selectCategory('Following');
    _showToast('Showing rooms where people you follow are active.');
  }

  @override
  Widget build(BuildContext context) {
    final visibleRooms = _visibleRooms;
    final totalRooms = _filteredRooms.length;

    return Scaffold(
      backgroundColor: const Color(0xFFFAF7F1),
      body: SafeArea(
        child: CustomScrollView(
          controller: _scrollController,
          slivers: [
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(18, 14, 18, 10),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    _HomeHeader(
                      user: widget.user,
                      onSearchTap: () => _showToast('Search will open here.'),
                      onNotificationsTap: () =>
                          _showToast('Notifications will open here.'),
                    ),
                    const SizedBox(height: 22),
                    _BannerModule(
                      controller: _bannerController,
                      currentIndex: _currentBannerIndex,
                      canManageBanners: _canManageBanners,
                      onManageTap: () => _showToast(
                        _canManageBanners
                            ? 'Banner management opens here for Super Owner / Owner.'
                            : 'All active banners will open here.',
                      ),
                      onBannerTap: (banner) => _showToast(
                        '${banner.title.replaceAll('\n', ' ')} opened.',
                      ),
                      onPageChanged: (index) {
                        setState(() {
                          _currentBannerIndex = index;
                        });
                      },
                    ),
                    const SizedBox(height: 18),
                    _FollowingRoomsModule(
                      onTap: _openFollowingRooms,
                      activeCount: _roomItems
                          .where((room) => room.followedFriendsInside.isNotEmpty)
                          .length,
                    ),
                    const SizedBox(height: 22),
                    _CategoryChips(
                      selectedCategory: _selectedCategory,
                      onSelected: _selectCategory,
                    ),
                    const SizedBox(height: 16),
                    _LanguageSelector(
                      selectedLanguage: _selectedLanguage,
                      onTap: _openLanguageSheet,
                    ),
                    const SizedBox(height: 20),
                    _SectionHeader(
                      title: _selectedCategory == 'Following'
                          ? 'Following Rooms'
                          : 'Trending Rooms',
                      actionText: 'See All',
                      onActionTap: () {
                        setState(() {
                          _visibleRoomCount = _filteredRooms.length;
                        });
                        _showToast('Showing all matching rooms.');
                      },
                    ),
                    const SizedBox(height: 6),
                    Text(
                      '$totalRooms rooms â€¢ $_selectedLanguage language â€¢ ranked by live trend score',
                      style: const TextStyle(
                        color: Color(0xFF8B8098),
                        fontSize: 12,
                        fontWeight: FontWeight.w700,
                      ),
                    ),
                    const SizedBox(height: 12),
                  ],
                ),
              ),
            ),
            if (visibleRooms.isEmpty)
              const SliverFillRemaining(
                hasScrollBody: false,
                child: _EmptyRoomsState(),
              )
            else
              SliverPadding(
                padding: const EdgeInsets.fromLTRB(18, 0, 18, 130),
                sliver: SliverList.separated(
                  itemCount: visibleRooms.length + (_isLoadingMore ? 1 : 0),
                  separatorBuilder: (context, index) => const SizedBox(height: 14),
                  itemBuilder: (context, index) {
                    if (index >= visibleRooms.length) {
                      return const _LoadingMoreCard();
                    }

                    final room = visibleRooms[index];

                    return _RoomCard(
                      room: room,
                      rank: index + 1,
                      onJoinTap: () => _showToast('Joining ${room.title}...'),
                    );
                  },
                ),
              ),
          ],
        ),
      ),
    );
  }
}

