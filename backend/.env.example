# FunKey / VibeMatch backend environment template
# Copy this file to backend/.env on the server and fill real values there.
# Never commit backend/.env or any service-account JSON.

APP_NAME=FunKey
APP_ENV=production
ENFORCE_SCHEMA_CURRENT=true
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Database
# Use strong passwords and keep PostgreSQL private to the deployment network.
database_url=postgresql://vibematch_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/vibematch

# Read replicas are disabled until a measured stale-tolerant route is approved.
DB_READ_REPLICA_ENABLED=false
READ_REPLICA_DATABASE_URL=

# Redis / Valkey roles.
# Production requires three distinct HA endpoints. Keep URLs/credentials secret.
# redis_url is retained only as a local-development compatibility fallback.
redis_url=redis://:CHANGE_ME_CACHE_REDIS_PASSWORD@127.0.0.1:6379/0
CACHE_REDIS_URL=rediss://:CHANGE_ME_CACHE_REDIS_PASSWORD@cache-redis.internal:6379/0
REALTIME_REDIS_URL=rediss://:CHANGE_ME_REALTIME_REDIS_PASSWORD@realtime-redis.internal:6379/0
MEDIA_REGISTRY_REDIS_URL=rediss://:CHANGE_ME_MEDIA_REDIS_PASSWORD@media-redis.internal:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
CACHE_REDIS_MAX_CONNECTIONS=50
REALTIME_REDIS_MAX_CONNECTIONS=100
MEDIA_REGISTRY_REDIS_MAX_CONNECTIONS=30

# Shared only between FastAPI and canonical backend_media workers.
MEDIA_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
MEDIA_NODE_TTL_SECONDS=30
MEDIA_ROOM_ASSIGNMENT_TTL_SECONDS=86400

# JWT / auth
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Realtime capability issuer. Generate a dedicated 32-byte Ed25519 seed and
# store only the base64url value in the API secret store. Never expose it to Go.
REALTIME_CAPABILITY_PRIVATE_KEY_B64=CHANGE_ME_BASE64URL_32_BYTE_ED25519_SEED
REALTIME_CAPABILITY_KEY_ID=funkey-realtime-v1
REALTIME_CAPABILITY_ISSUER=funkey-api
REALTIME_CAPABILITY_AUDIENCE=funkey-realtime
REALTIME_CAPABILITY_TTL_SECONDS=300
REALTIME_CAPABILITY_TOKEN_VERSION=1
FOUNDER_OWNER_PUBLIC_ID=6922022
FOUNDER_OWNER_EMAIL=founder@yourdomain.com
ENABLE_DEV_LOGIN=false

# Google sign-in OAuth client IDs, comma separated.
# Add Android, Web and iOS client IDs if those platforms are enabled.
GOOGLE_AUTH_CLIENT_IDS=CHANGE_ME_ANDROID_CLIENT_ID.apps.googleusercontent.com,CHANGE_ME_WEB_CLIENT_ID.apps.googleusercontent.com

# Gift dynamic asset CDN. Keep empty only for closed-beta local bundled fallback.
GIFT_CDN_BASE_URL=https://cdn.yourdomain.com/gifts

# Production media storage.
# local = dev only. s3 = Oracle Object Storage S3-compatible API, AWS S3, Cloudflare R2, MinIO, etc.
MEDIA_STORAGE_DRIVER=s3
MEDIA_CDN_BASE_URL=https://cdn.yourdomain.com/media
MEDIA_S3_BUCKET=CHANGE_ME_BUCKET_NAME
MEDIA_S3_REGION=CHANGE_ME_REGION
MEDIA_S3_ENDPOINT_URL=https://CHANGE_ME_NAMESPACE.compat.objectstorage.CHANGE_ME_REGION.oraclecloud.com
MEDIA_S3_ACCESS_KEY_ID=CHANGE_ME_ORACLE_CUSTOMER_SECRET_KEY_ID
MEDIA_S3_SECRET_ACCESS_KEY=CHANGE_ME_ORACLE_CUSTOMER_SECRET
MEDIA_S3_PUBLIC_READ=true

# Google Drive backup / restore.
# Keep disabled in UI until these are real production OAuth values.
GOOGLE_DRIVE_CLIENT_ID=CHANGE_ME_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=CHANGE_ME_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=https://api.yourdomain.com/api/v1/inbox/backup/google/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
INBOX_BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_OR_LONGER_RANDOM_SECRET

# Firebase Cloud Messaging backend HTTP v1.
# Store the JSON only on the server, for example backend/secrets/firebase-service-account.json.
FCM_PROJECT_ID=funkey-69
FIREBASE_SERVICE_ACCOUNT_PATH=/opt/funkey/backend/secrets/firebase-service-account.json

# Optional OpenAI moderation.
# Required only if OpenAI moderation is enabled in control center/settings.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
# Alternative accepted by code:
# FUNKEY_OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# Extracted Vibes service (Chunk 24). Production binds a distinct DB login.
VIBES_SERVICE_URL=http://funkey-vibes:8084/api/v1
VIBES_INTERNAL_URL=http://funkey-vibes:8084/internal/vibes
VIBES_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
VIBES_DATABASE_URL=postgresql://funkey_vibes:CHANGE_ME_DB_PASSWORD@pgbouncer.internal:6432/funkey
VIBES_DB_POOL_SIZE=5
VIBES_DB_MAX_OVERFLOW=0
VIBES_MAX_REPLICAS=20
DB_VIBES_CONNECTION_BUDGET=100


# Extracted Room Control service (Chunk 26). Production uses its own DB login.
ROOM_CONTROL_SERVICE_URL=http://funkey-room-control:8085/api/v1
ROOM_CONTROL_INTERNAL_URL=http://funkey-room-control:8085/internal/room-control
ROOM_CONTROL_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
ROOM_CONTROL_DATABASE_URL=postgresql://funkey_room_control:CHANGE_ME_DB_PASSWORD@pgbouncer.internal:6432/funkey
ROOM_CONTROL_DB_POOL_SIZE=3
ROOM_CONTROL_DB_MAX_OVERFLOW=0
ROOM_CONTROL_DB_POOL_TIMEOUT_SECONDS=3
ROOM_CONTROL_MAX_REPLICAS=20
DB_ROOM_CONTROL_CONNECTION_BUDGET=60

# Extracted Identity service (Chunk 27).
IDENTITY_SERVICE_URL=http://funkey-identity:8086/api/v1
IDENTITY_INTERNAL_URL=http://funkey-identity:8086/internal/identity
IDENTITY_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
IDENTITY_DATABASE_URL=postgresql://funkey_identity:CHANGE_ME_DB_PASSWORD@pgbouncer.internal:6432/funkey
IDENTITY_DB_POOL_SIZE=3
IDENTITY_DB_MAX_OVERFLOW=0
IDENTITY_DB_POOL_TIMEOUT_SECONDS=3
IDENTITY_MAX_REPLICAS=20
DB_IDENTITY_CONNECTION_BUDGET=60
# Extracted Profile/Social service (Chunk 27).
PROFILE_SOCIAL_SERVICE_URL=http://funkey-profile-social:8087/api/v1
PROFILE_SOCIAL_INTERNAL_URL=http://funkey-profile-social:8087/internal/profile-social
PROFILE_SOCIAL_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
PROFILE_SOCIAL_DATABASE_URL=postgresql://funkey_profile_social:CHANGE_ME_DB_PASSWORD@pgbouncer.internal:6432/funkey
PROFILE_SOCIAL_DB_POOL_SIZE=4
PROFILE_SOCIAL_DB_MAX_OVERFLOW=0
PROFILE_SOCIAL_DB_POOL_TIMEOUT_SECONDS=3
PROFILE_SOCIAL_MAX_REPLICAS=20
DB_PROFILE_SOCIAL_CONNECTION_BUDGET=80

# Restored Chunk 25 Economy service.
ECONOMY_SERVICE_URL=http://funkey-economy:8088/api/v1
ECONOMY_INTERNAL_URL=http://funkey-economy:8088/internal/economy
ECONOMY_INTERNAL_TOKEN=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
ECONOMY_DATABASE_URL=postgresql://funkey_economy:CHANGE_ME_DB_PASSWORD@pgbouncer.internal:6432/funkey
ECONOMY_DB_POOL_SIZE=4
ECONOMY_DB_MAX_OVERFLOW=0
ECONOMY_DB_POOL_TIMEOUT_SECONDS=3
ECONOMY_MAX_REPLICAS=20
DB_ECONOMY_CONNECTION_BUDGET=80
