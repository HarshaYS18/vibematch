{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funkey.example/contracts/events/kafka-analytics-envelope-v1.schema.json",
  "title": "FunKey Kafka Analytics Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "schema_version",
    "occurred_at",
    "published_at",
    "producer",
    "source_service",
    "topic_family",
    "partition_key",
    "payload"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "event_version": {"type": "integer", "minimum": 1},
    "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "nats-jetstream-bridge"},
    "source_service": {"type": "string", "minLength": 1, "maxLength": 100},
    "topic_family": {
      "enum": [
        "user.activity",
        "room.events",
        "vibes.engagement",
        "economy.analytics",
        "game.events",
        "media.events",
        "recommendation.events"
      ]
    },
    "partition_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_id": {"type": ["string", "null"], "maxLength": 64},
    "trace_id": {"type": ["string", "null"], "maxLength": 64},
    "correlation_id": {"type": ["string", "null"], "maxLength": 128},
    "causation_id": {"type": ["string", "null"], "maxLength": 128},
    "actor_user_id": {"type": ["integer", "null"]},
    "replay": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["replay_id", "source_topic", "source_partition", "source_offset"],
      "properties": {
        "replay_id": {"type": "string"},
        "source_topic": {"type": "string"},
        "source_partition": {"type": "integer", "minimum": 0},
        "source_offset": {"type": "integer", "minimum": 0}
      }
    },
    "payload": {"type": "object"}
  }
}
