# Local service port.
PORT=4000

# Android emulator: use 10.0.2.2 here and in the Flutter test page server URL.
# Real phone on same Wi-Fi: use your laptop Wi-Fi IP, for example 192.168.1.8.
# Local desktop/browser only: 127.0.0.1 is fine.
ANNOUNCED_IP=10.0.2.2

# MVP local test page does not request backend audio JWT yet.
# Keep false for local standalone testing. Set true later when backend audio-session token API is wired.
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
REQUIRE_AUDIO_TOKEN=false

# Multi-room worker pool.
# Default is min(CPU cores, 4). Increase later on real servers after load tests.
MEDIASOUP_WORKER_COUNT=4

# Small-beta room limits. These are server-wide and can be tuned after real load tests.
MAX_ROOMS=500
MAX_SPEAKERS_PER_ROOM=17
MAX_ROOM_PEERS=250

# Empty or stale rooms are cleaned to prevent local/server resource leaks.
ROOM_IDLE_CLEANUP_MS=600000
ROOM_CLEANUP_INTERVAL_MS=60000

# Keep a small explicit RTC port range so local firewall/cloud security groups are easy to configure.
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# Local coturn defaults. Change before public deployment.
TURN_HOST=10.0.2.2
TURN_PORT=3478
TURN_USERNAME=vibematch-local
TURN_PASSWORD=vibematch-local-password
